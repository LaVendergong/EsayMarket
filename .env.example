# ============================================================
# docker compose 用的环境变量模板
#   cp .env.example .env   然后把下面三个值改成真实值（.env 已在 .gitignore 里，不会被提交）
# ============================================================

# MySQL root 口令（必填）
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-password

# JWT 签名密钥（必填），两个后端必须用同一个值
# 至少 32 字节。生成方式：
#   Linux/macOS : openssl rand -hex 32
#   PowerShell  : -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
MALL_JWT_SECRET=change-me-to-64-hex-chars

# 敏感字段（手机号/收货人/地址）加密主密钥（必填），两个后端必须用同一个值
# **必须与 MALL_JWT_SECRET 不同**（签名密钥泄露时不该连带解开库里所有 PII）
# 同样 32+ 字符。⚠️ 上线后不要随意更换：换了以后旧密文就解不开了
MALL_CRYPTO_SECRET=change-me-to-another-64-hex-chars
