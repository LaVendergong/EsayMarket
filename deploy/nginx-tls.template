# ============================================================================
# 本地部署栈的前端 TLS 配置（nginx 官方镜像的 templates 机制，启动时 envsubst）
#
# 用同一份模板服务两个前端，靠环境变量区分：
#   UPSTREAM     mall-portal:8090 / mall-admin:8081
#   HTTPS_PORT   宿主机映射的 https 端口（15174 / 15173），用于 http -> https 跳转
#
# 注意：envsubst 只替换**已定义的环境变量**，所以 nginx 自己的 $host / $request_uri
# 不会被误替换。
#
# 这里用自签证书（deploy/certs，由 scripts/gen-certs.sh 生成）：
# 本地/自动化能完整验证 TLS 行为，但浏览器会有证书警告 —— 真实证书要在线上换。
# ============================================================================
server {
    listen 80;
    server_name _;

    # 跳转目标必须带上**宿主机映射的端口**，否则会跳到 443（容器内），浏览器连不上
    return 301 https://$host:${HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    server_tokens off;

    # 安全响应头：上 TLS 之后才加 HSTS（http 下加没有意义，还会把自己锁死）
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # 后端接口：同源反代
    #   Origin 头必须去掉：浏览器对本域名的 POST 也会带 Origin，
    #   Spring 的 CorsFilter 看到就按跨域处理（历史事故：登录 403）
    location /api/ {
        proxy_pass http://${UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Origin "";
    }

    location /img/ {
        proxy_pass http://${UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
}
