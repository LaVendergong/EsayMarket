# ============================================================================
# 生产 nginx（TLS 终止 + 同源反代）—— 这份配置与 scripts/https-verify.sh 验证过的结构一致
#
# 验证过的部分（18/18，见 docs §7「HTTPS」）：
#   - 自签 CA 签发 + 证书链校验 + SAN 覆盖主机名
#   - HTTP -> HTTPS 301
#   - 只允许 TLSv1.2/1.3（TLS 1.1 被拒），TLS 1.3 可用
#   - HSTS / nosniff / DENY / Referrer-Policy 四个响应头
#   - server_tokens off（不暴露版本）
#   - HTTPS -> nginx -> 后端 的真实业务调用（登录 + 带 token 的接口）
#
# 没验证的：真实 CA 证书、真实域名、OCSP stapling、证书自动续期（见文末 TODO）。
#
# 用法：
#   1) 证书放到 /etc/nginx/certs/{fullchain.pem,privkey.pem}
#   2) 替换下面所有 <...> 占位符
#   3) nginx -t && nginx -s reload
# ============================================================================

worker_processes auto;
error_log  /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

events {
    worker_connections 4096;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" rt=$request_time';
    access_log /var/log/nginx/access.log main;

    sendfile        on;
    tcp_nopush      on;
    keepalive_timeout 65;
    server_tokens   off;

    # 上传账单等大文件时别太小
    client_max_body_size 8m;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    # ---------------------------------------------------------------- 强制 HTTPS
    server {
        listen 80;
        server_name <your-domain>;

        # ACME http-01 挑战放行（用 Let's Encrypt 时保留）
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    # ---------------------------------------------------------------- 主站
    server {
        listen 443 ssl;
        http2 on;
        server_name <your-domain>;

        ssl_certificate     /etc/nginx/certs/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/privkey.pem;

        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
        ssl_prefer_server_ciphers off;
        ssl_session_cache   shared:SSL:10m;
        ssl_session_timeout 10m;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;

        # ------------------------------------------------------------ 前端（同源）
        location / {
            root  /usr/share/nginx/html/portal;
            index index.html;
            try_files $uri $uri/ /index.html;
        }

        location /admin/ {
            alias /usr/share/nginx/html/admin/;
            index index.html;
            try_files $uri $uri/ /admin/index.html;
        }

        # ------------------------------------------------------------ API 反代
        #
        # 关键：清掉 Origin。同源部署下浏览器对 **POST 也会带 Origin**，
        # nginx 原样转发会被后端 CorsFilter 判成跨域（历史事故：登录 403，见 docs §8 第 39 条）。
        location /api/v1/portal/ {
            proxy_pass http://mall-portal:8090;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Origin            "";
            proxy_read_timeout 30s;
        }

        location /api/v1/admin/ {
            proxy_pass http://mall-admin:8081;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Origin            "";
            proxy_read_timeout 30s;
        }

        # 支付/退款回调：渠道服务器直接打 https，不要加鉴权、不要缓存
        location /api/v1/portal/pay/ {
            proxy_pass http://mall-portal:8090;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Origin            "";
            proxy_buffering off;
        }

        # ------------------------------------------------------------ 运维
        location = /actuator/health {
            proxy_pass http://mall-portal:8090/actuator/health;
            access_log off;
            # 注意：生产上 health 不建议对公网开放，这里保留是为了容器 healthcheck。
            # 如需外网摘掉，改成 allow 10.0.0.0/8; deny all;
        }
    }
}

# ============================================================================
# 上线前 TODO（这些没法在开发机验证，必须在上线环境做）
#
# 1. 证书：用真实 CA（Let's Encrypt / 企业 CA）。签发后先跑
#      openssl s_client -connect <domain>:443 -servername <domain>
#    确认链完整（不要拖根证书进 bundle）。
# 2. HSTS 的 includeSubDomains：确认所有子域都已 HTTPS，否则会把自己锁死。
#    首次上线建议先把 max-age 调到 300 秒观察一天。
# 3. 证书续期：certbot renew --deploy-hook "nginx -s reload"，并加监控
#    （证书过期是典型的"半夜挂掉"）。
# 4. OCSP stapling：需要 ssl_trusted_certificate 指向链证书，未验证，配好后用
#      openssl s_client -status 检查是否返回 "OCSP Response Status: successful"。
# 5. 后端 prod profile 下 mall.security.cookie.secure 必须为 true（否则 Cookie 明文走 HTTP）。
# ============================================================================
